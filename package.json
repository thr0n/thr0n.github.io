{
  "private": true,
  "name": "thr0n.github.io",
  "description": "Just another tech blog.",
  "version": "1.1.0",
  "author": "Hendrik Bölcke <hendrik.thorun@gmail.com>",
  "license": "0BSD",
  "starter-name": "gatsby-starter-minimal-blog",
  "scripts": {
    "build": "gatsby build",
    "cypress:open": "cypress open --browser chrome --e2e",
    "cypress:run": "CYPRESS_baseUrl=http://localhost:9000 cypress run --browser chrome",
    "test:e2e": "CYPRESS_SUPPORT=y start-server-and-test develop http://localhost:8000 cypress:open",
    "test:e2e:ci": "start-server-and-test serve http://localhost:9000 cypress:run",
    "develop": "gatsby develop",
    "start": "gatsby develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "deploy": "gatsby build && gh-pages -d public -b gh-pages",
    "deploy-only": "gh-pages -d public -b gh-pages",
    "cy:run": "CYPRESS_baseUrl=http://localhost:9000 cypress run --browser chrome"
  },
  "dependencies": {
    "@lekoarts/gatsby-theme-minimal-blog": "6.2.6",
    "gatsby": "5.16.1",
    "gatsby-plugin-feed": "5.16.0",
    "gatsby-plugin-manifest": "5.16.0",
    "gatsby-plugin-sitemap": "6.16.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "10.1.0",
    "cypress": "15.13.0",
    "gh-pages": "6.3.0",
    "prettier": "3.8.1",
    "start-server-and-test": "3.0.0",
    "typescript": "6.0.2"
  }
}
